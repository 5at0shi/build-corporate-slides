# Python
.venv/
__pycache__/
*.pyc

# OS
.DS_Store

# build_slides/ は利用者の作業領域。中身は追跡しない
# （サンプルは samples/ に置く。PDFはsamples/render_samples.pyで作り直せる）
build_slides/output/*
build_slides/work/render/
build_slides/work/*.yaml
build_slides/work/*.py
build_slides/work/*/render/

# Human-provided input material (photos, maps, etc.) — workspace-specific,
# often third-party copyrighted content not meant for the skill repo
build_slides/input/

# Session-local runtime state (Claude Code scheduled wakeups)
.claude/scheduled_tasks.lock

# Skill package builds — use GitHub Releases if these need to be kept
skill-packages/

# Historical test scratch from earlier skill versions
test-results/

# One-off skill vs. freeform comparison experiment
compare/
